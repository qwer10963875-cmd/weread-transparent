{
  "manifest_version": 3,
  "name": "微信读书透明层",
  "version": "1.0.0",
  "description": "把微信读书网页版改造成透明底、灰色字的悬浮阅读层",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
